# ────────────────────────────────────────────────────────────────────────────
# Candor — AI Junior Analyst — environment
#
# The app runs with ZERO configuration in DEMO MODE (rich scripted data).
# For LIVE mode, Candor is PROVIDER-AGNOSTIC — run it fully FREE (see below).
# ────────────────────────────────────────────────────────────────────────────

# "demo" = scripted pipeline + mock memos (no external calls, no keys).
# "live" = real planner/tools/synthesis/critique against the provider below.
CANDOR_MODE=demo

# Global kill switch — "true" hard-disables live model/tool calls (→ demo).
CANDOR_KILL_SWITCH=false

# Per-IP daily query cap for the live agent (cost safety).
CANDOR_DAILY_QUERY_CAP=25

# ── LLM providers (all FREE) ────────────────────────────────────────────────
# Set the PRIMARY here; every other provider you add a key for becomes an
# automatic fallback when the primary's daily quota runs out. Adding 2–3 keys is
# what makes a public deployment survive on free tiers.
#   cerebras   → 1M tokens/day free, no card       (RECOMMENDED primary)
#   groq       → 100k/day on 70B, very fast
#   gemini     → ~250 req/day, also free embeddings
#   openrouter → free ":free" models
#   ollama     → 100% local, no key, no network
CANDOR_LLM_PROVIDER=cerebras

# Cerebras — free key, 1M tokens/day: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Groq — free key, no credit card:  https://console.groq.com/keys
GROQ_API_KEY=
# Gemini — free key:                https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter — free ":free" models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama (local) — install then `ollama pull llama3.1`. No key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Optional per-tier model overrides (blank → sensible per-provider defaults:
# planner = a small/fast model, synth/critic = a larger one).
CANDOR_MODEL_PLANNER=
CANDOR_MODEL_SYNTH=
CANDOR_MODEL_CRITIC=

# ── Embeddings (filing RAG only — optional, needs Supabase) ──────────────────
#   gemini (free) | ollama (local: `ollama pull nomic-embed-text`) | voyage (paid)
# NOTE: CANDOR_EMBEDDING_DIM must match the vector(dim) in the SQL migration.
CANDOR_EMBED_PROVIDER=gemini
CANDOR_EMBEDDING_MODEL=gemini-embedding-001
CANDOR_EMBEDDING_DIM=768
VOYAGE_API_KEY=

# ── SEC EDGAR (highest-value source; required for live filings/fundamentals) ─
# SEC fair-access REQUIRES a descriptive User-Agent with contact info.
SEC_USER_AGENT="Candor Research (student project) your-name your-email@example.com"

# ── Market data + news (free tiers) ─────────────────────────────────────────
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=

# ── Supabase (Postgres + pgvector) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Memo cache (how a public deploy stays free) ─────────────────────────────
# A recent stored memo is replayed instead of re-running the agent, so repeat
# visits cost nothing. Filings don't change hour to hour; 12h is a sane default.
CANDOR_CACHE_TTL_HOURS=12

# ── Calibration resolution (public track record) ────────────────────────────
CANDOR_BENCHMARK=SPY
# Shared secret protecting POST /api/cron/resolve (set in production).
CRON_SECRET=
